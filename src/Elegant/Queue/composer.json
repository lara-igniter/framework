{
    "name": "elegant/queue",
    "description": "The Elegant Queue package.",
    "license": "MIT",
    "homepage": "https://laraigniter.com",
    "support": {
        "issues": "https://github.com/lara-igniter/framework/issues",
        "source": "https://github.com/lara-igniter/framework"
    },
    "authors": [
        {
            "name": "George Tsachrelias",
            "email": "giorgosstab@laraigniter.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "ext-pcntl": "*",
        "ext-readline": "*",
        "elegant/contracts": "1.0",
        "elegant/support": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Elegant\\Queue\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "suggest": {
        "ext-pcntl": "Required to use all features of the queue worker."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
